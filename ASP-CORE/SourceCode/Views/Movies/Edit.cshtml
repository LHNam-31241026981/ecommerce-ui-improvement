@model Filmora.ViewModels.MovieInput
@{ ViewData["Title"] = "Sửa phim"; }
<header class="page-heading"><h1>Sửa phim</h1></header>
<form class="panel" asp-action="Edit" asp-route-id="@Model.Id" asp-antiforgery="true" method="post" enctype="multipart/form-data">
    <partial name="_Fields" model="Model" />
    <div class="form-actions">
        <button class="button button-primary" type="submit">Lưu thay đổi</button>
        <a class="button button-secondary" asp-action="Manage">Hủy</a>
    </div>
</form>
