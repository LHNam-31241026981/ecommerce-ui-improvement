@model IReadOnlyList<Filmora.Models.Movie>
@using System.Globalization
@{
    ViewData["Title"] = "Quản lý phim";
    var currency = CultureInfo.GetCultureInfo("vi-VN");
}
<header class="page-heading">
    <h1>Quản lý phim</h1>
    <div class="form-actions">
        <a class="button button-secondary" asp-controller="Genres" asp-action="Index">Quản lý thể loại</a>
        <a class="button button-primary" asp-action="Create">Thêm phim</a>
    </div>
</header>
@if (Model.Count == 0)
{
    <section class="empty-state"><h2>Chưa có phim</h2><p>Dùng nút “Thêm phim” để tạo mục đầu tiên.</p></section>
}
else
{
    <div class="panel table-wrap">
        <table class="data-table">
            <thead><tr><th scope="col">Tên phim</th><th scope="col">Thể loại</th><th scope="col">Phát hành</th><th scope="col">Giá vé</th><th scope="col">Điểm</th><th scope="col">Thao tác</th></tr></thead>
            <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <th scope="row"><a asp-action="Details" asp-route-id="@movie.Id">@movie.Title</a></th>
                    <td>@movie.Genre.Name</td>
                    <td>@movie.ReleaseDate.ToString("dd/MM/yyyy")</td>
                    <td>@movie.Price.ToString("N0", currency) ₫</td>
                    <td>@movie.Rated/5</td>
                    <td>
                        <div class="form-actions">
                            <a class="button button-secondary" asp-action="Edit" asp-route-id="@movie.Id">Sửa</a>
                            <a class="button button-danger" asp-action="Delete" asp-route-id="@movie.Id">Xóa</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
