@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@if (SignInManager.IsSignedIn(User))
{
    <a class="account-name" asp-area="Identity" asp-page="/Account/Manage/Index">Tài khoản</a>
    <form class="logout-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Movies", new { area = "" })" method="post">
        <button type="submit" class="nav-button">Đăng xuất</button>
    </form>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
    <a asp-area="Identity" asp-page="/Account/Register" class="nav-register">Đăng ký</a>
}
